# QuickEats - Local Development Environment Variables

# MongoDB Configuration
# Get your URI from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/quickeats_dev

# Next.js Configuration
NEXT_PUBLIC_APP_NAME=QuickEats
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Feature Flags
ENABLE_REDIS=false
ENABLE_ANALYTICS=true
ENABLE_SURGE_PRICING=true

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Payment Gateway (Optional)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Node Environment
NODE_ENV=development
