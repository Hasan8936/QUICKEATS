# Copy this file to .env.local for local development.
# In production (Vercel), set these in the project's Environment Variables
# dashboard instead of committing a real .env.production file.

# MongoDB Atlas connection string. Get this from Atlas > Database > Connect
# > Drivers, or from `claude` if it created a cluster for you.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/quickeats?retryWrites=true&w=majority

NEXT_PUBLIC_APP_NAME=QuickEats
